#!/usr/bin/env python3
"""usb-prompt: a notification for every USB device USBGuard blocks, with an "Allow" button (allows it until it is
unplugged; nothing is remembered). Runs as the live user (wheel may talk to usbguard, see usbguard-daemon.conf)."""
import re, subprocess, threading, time

KINDS = {"03": "keyboard / mouse / HID", "08": "storage", "09": "hub", "02": "network / modem", "0e": "camera",
         "01": "audio", "e0": "wireless (Bluetooth)", "07": "printer", "0a": "data"}

def describe(rule):
    name = re.search(r'name "([^"]*)"', rule)
    ifaces = re.search(r'with-interface (\{[^}]*\}|\S+)', rule)
    kinds = sorted({KINDS.get(c[:2], "class " + c[:2]) for c in re.findall(r'([0-9a-f]{2}):[0-9a-f*]{2}:[0-9a-f*]{2}', ifaces.group(1) if ifaces else "")})
    text = (name.group(1) if name and name.group(1) else "Unknown device") + (" (" + ", ".join(kinds) + ")" if kinds else "")
    if any(k.startswith("keyboard") for k in kinds):
        text += "\nIt can type: only allow it if you just plugged in a keyboard or mouse."
    return text

def prompt(dev_id, text):
    r = subprocess.run(["notify-send", "-a", "USBGuard", "-u", "critical", "-i", "drive-removable-media",
                        "--action=allow=Allow", "--wait", "USB device blocked", text], capture_output=True, text=True)
    if r.stdout.strip() == "allow":
        subprocess.run(["usbguard", "allow-device", dev_id])

def watch():
    p = subprocess.Popen(["usbguard", "watch"], stdout=subprocess.PIPE, text=True)
    dev = target = None
    for line in p.stdout:
        line = line.strip()
        if m := re.match(r"\[device\] (PresenceChanged|PolicyChanged): id=(\d+)", line):
            dev, target = m.group(2), None
        elif line.startswith("target="):
            target = line.split("=", 1)[1]
        elif line.startswith("device_rule=") and dev and target == "block":
            threading.Thread(target=prompt, args=(dev, describe(line)), daemon=True).start()
            dev = None
    p.wait()

while True:
    try:
        watch()
    except Exception:
        pass
    time.sleep(3)

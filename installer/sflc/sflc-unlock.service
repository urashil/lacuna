[Unit]
Description=Unlock the system (Shufflecake)
DefaultDependencies=no
After=systemd-udev-trigger.service systemd-udevd.service systemd-modules-load.service
Wants=systemd-udev-trigger.service
Before=initrd-root-device.target sysroot.mount
ConditionPathExists=/etc/initrd-release

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/sflc/unlock

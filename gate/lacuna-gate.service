[Unit]
Description=Lacuna network gate: default-drop firewall before any network comes up
DefaultDependencies=no
Before=network-pre.target NetworkManager.service
Wants=network-pre.target
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/lacuna/gate apply greeter

[Install]
WantedBy=sysinit.target

class Apps(Step):
    TITLE = "Apps for this session"
    HINT = ("Besides Tor Browser, a terminal, files and KeePassXC. Each app you add runs on its own Tor circuits; "
            "nothing starts by itself. Logging into an app still tells that service it's you.")

    def compose(self) -> ComposeResult:
        st = daemon("state")
        on = set(st.get("apps") or st.get("saved_apps") or [])
        self.names = st.get("opsec_apps") or list(APP_LABELS)
        with Center(classes="card"):
            with Vertical():
                yield from self.head()
                with VerticalScroll(classes="body"):
                    for n in self.names:
                        with Horizontal(classes="row"):
                            yield Switch(value=n in on, id=f"a_{n}")
                            yield Label(APP_LABELS.get(n, n))
                with Horizontal(classes="buttons"):
                    yield Button("Back", id="back")
                    yield Button("Continue", variant="primary", id="go")
                yield Label("", id="msg")
        yield Footer()

    def on_mount(self):
        sw = self.query(Switch)
        (sw.first() if sw else self.query_one("#go")).focus()

    @on(Button.Pressed, "#back")
    def back(self):
        self.app.pop_screen()

    @on(Button.Pressed, "#go")
    def go(self):
        apps = [n for n in self.names if self.query_one(f"#a_{n}", Switch).value]
        r = daemon("set_apps", apps=apps)
        if not r.get("ok"):
            self.say(r.get("error") or "could not set the apps", error=True); return
        self.app.push_screen(Start())


class Start(Step):
    TITLE = "Ready"

    def compose(self) -> ComposeResult:
        with Center(classes="card"):
            with Vertical():
                yield from self.head()
                yield Static(f"Persistence: {dict(unlocked='unlocked', stickless='none (stickless)').get(self.app.persistence, 'not in use')}\n"
                             f"Network: {self.app.mode}\n"
                             f"Everything else is forgotten at shutdown.", classes="hint")
                yield Label("", id="net")
                yield Label("", id="note", classes="hint")
                with Horizontal(classes="buttons"):
                    yield Button("Back", id="back")
                    yield Button("Done" if self.app.settings else "Start Lacuna", variant="primary", id="go")
                yield Label("", id="msg")
        yield Footer()

    def on_mount(self):
        self.since = time.monotonic()
        self.query_one("#go").focus()
        self.poll()
        self.set_interval(1.0, self.poll)

    @work(thread=True, exclusive=True)
    def poll(self):
        st = daemon("gate_status")
        self.app.call_from_thread(self.show, st)

    def show(self, st):
        parts = []
        wanted = st.get("wanted") or ""
        vpn = wanted.removeprefix("tor+")
        vstate = (st.get("vpn_state") or "").lower()
        if st.get("error"):
            parts.append(f"Network: failed: {st['error']}")
        elif vpn in VPN_NAMES:
            parts.append(f"{VPN_NAMES[vpn]}: connected" if vstate == "connected"
                         else f"{VPN_NAMES[vpn]}: {st.get('vpn_state') or 'starting'}…")
        if wanted in ("tor",) or wanted.startswith("tor+"):
            if not st.get("error"):
                pct = st.get("tor_bootstrap")
                parts.append("Tor: connected" if pct == 100 else f"Tor: connecting {pct or 0}%")
        net = self.query_one("#net", Label)
        net.update("  ".join(parts))
        net.set_class(bool(st.get("error")), "error")
        # stuck at the start of bootstrapping for a minute: say what the transport says, and what to try
        note = ""
        pct = st.get("tor_bootstrap") or 0
        if (wanted == "tor" or wanted.startswith("tor+")) and pct < 15 and time.monotonic() - self.since > 60:
            note = ("Tor isn't getting through. This network may block it: try other bridges (meek works on "
                    "almost any network), or the restricted-network option.")
            if st.get("tor_note"):
                note += f"\nLast message: {st['tor_note']}"
        self.query_one("#note", Label).update(note)

    @on(Button.Pressed, "#back")
    def back(self):
        self.app.pop_screen()

    @on(Button.Pressed, "#go")
    def go(self):
        if self.app.settings:
            self.app.pop_screen()                       # back past Mode to the settings menu
            self.app.pop_screen()
            return
        r = daemon("finish")
        if not r.get("ok"):
            self.say(r.get("error") or "not ready", error=True); return
        err = start_session(self.app.session)
        if err:
            self.say(err, error=True)
        else:
            self.say("Starting…")



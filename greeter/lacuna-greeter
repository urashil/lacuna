class SettingsHome(Step):
    BINDINGS = [Binding("escape", "app.quit", "Close")]
    TITLE = "Lacuna Settings"

    def compose(self) -> ComposeResult:
        st = daemon("state")
        self.st = st
        if not st.get("persistence"):
            where = "Persistence: not in use. Changes last until shutdown."
        elif st.get("writable"):
            where = "Persistence: unlocked. Changes are saved and used at the next start."
        else:
            where = "Persistence: ~/Persistent only (no saved settings). Changes here last until shutdown."
        with Center(classes="card"):
            with Vertical():
                yield from self.head()
                yield Label(where, classes="hint")
                yield Button("Network: mode, bridges, VPN account", id="net")
                if st.get("session") != "opsec":
                    with Horizontal(classes="row"):
                        yield Switch(value=bool(st.get("unsafe")), id="unsafe")
                        yield Label("Unsafe Browser allowed (Wi-Fi sign-in pages, NOT anonymous)")
                yield Button("Leak test", id="leak")
                if st.get("writable"):
                    yield Button("What the persistence keeps", id="features")
                if not st.get("password_set"):
                    yield Button("Set an admin password (none is set)", id="password")
                with Horizontal(classes="buttons"):
                    yield Button("Close", variant="primary", id="close")
                yield Label("", id="msg")
        yield Footer()

    def on_mount(self):
        self.query_one("#net").focus()

    @on(Button.Pressed, "#net")
    def net(self):
        self.app.push_screen(Mode())

    @on(Switch.Changed, "#unsafe")
    def unsafe(self, ev):
        r = daemon("set_unsafe", on=ev.value)
        self.say(("Unsafe Browser allowed: it's in the launcher." if ev.value else "Unsafe Browser off (and closed).")
                 if r.get("ok") else (r.get("error") or "failed"), error=not r.get("ok"))

    @on(Button.Pressed, "#leak")
    def leak(self):
        self.app.push_screen(LeakTest())

    @on(Button.Pressed, "#features")
    def features(self):
        self.app.push_screen(Features())

    @on(Button.Pressed, "#password")
    def password(self):
        self.app.push_screen(Password())

    @on(Button.Pressed, "#close")
    def close(self):
        self.app.exit()

    fresh = True

    def on_screen_resume(self, event=None):
        self.call_after_refresh(self.fit_body)
        if self.fresh:                                  # the first time it's shown
            self.fresh = False
            return
        self.app.switch_screen(SettingsHome())          # back from a sub-screen: rebuilt, things may have changed


class Features(Step):
    TITLE = "What the persistence keeps"
    HINT = "Switched on: kept in the hidden part, from now on. Switched off: no longer kept (what was saved stays)."

    def compose(self) -> ComposeResult:
        r = daemon("features")
        self.items = r.get("features", [])
        with Center(classes="card"):
            with Vertical():
                yield from self.head()
                with VerticalScroll(classes="body"):
                    for f in self.items:
                        with Horizontal(classes="row"):
                            yield Switch(value=f["on"], id=f"f_{f['name']}")
                            yield Label(f["description"])
                    if not self.items:
                        yield Label(r.get("error") or "The persistence isn't unlocked.", classes="warn")
                with Horizontal(classes="buttons"):
                    yield Button("Back", variant="primary", id="back")
                yield Label("", id="msg")
        yield Footer()

    def on_mount(self):
        sw = self.query(Switch)
        (sw.first() if sw else self.query_one("#back")).focus()

    @on(Switch.Changed)
    def changed(self, ev):
        name = ev.switch.id[2:]
        r = daemon("set_feature", name=name, on=ev.value)
        self.say(f"{name}: {'kept' if ev.value else 'no longer kept'}" if r.get("ok") else (r.get("error") or "failed"),
                 error=not r.get("ok"))

    @on(Button.Pressed, "#back")
    def back(self):
        self.app.pop_screen()


class LeakTest(Step):
    TITLE = "Leak test"
    HINT = ("Probes from your user and from root: what the outside sees, IPv6, ping, UDP, DNS, the Unsafe Browser. "
            "The negative control opens a deliberate hole first: then the test must report a leak.")

    def compose(self) -> ComposeResult:
        with Center(classes="card"):
            with Vertical():
                yield from self.head()
                with VerticalScroll(classes="body"):
                    yield Static("Not run yet.", id="out")
                with Horizontal(classes="buttons"):
                    yield Button("Back", id="back")
                    yield Button("Negative control", id="inject")
                    yield Button("Run", variant="primary", id="go")
                yield Label("", id="msg")
        yield Footer()

    def on_mount(self):
        self.query_one("#go").focus()

    @on(Button.Pressed, "#back")
    def back(self):
        self.app.pop_screen()

    @on(Button.Pressed, "#inject")
    def inject(self):
        self.start(True)

    @on(Button.Pressed, "#go")
    def go(self):
        self.start(False)

    def start(self, inject):
        self.say("Running… (up to a few minutes over Tor)")
        self.query_one("#out", Static).update("")
        self.test(inject)

    @work(thread=True, exclusive=True)
    def test(self, inject):
        r = daemon("leaktest", _timeout=450, inject=inject)
        self.app.call_from_thread(self.show, r, inject)

    def show(self, r, inject):
        self.query_one("#out", Static).update(r.get("output") or r.get("error") or "no answer")
        good = r.get("passed")
        self.say(("Negative control: the injected leak was seen, so the test works." if good else
                  "Negative control: the injected leak was NOT seen. The checks are blind here.") if inject else
                 ("No leaks." if good else "LEAK found: see above."), error=not good)


class Password(Step):
    TITLE = "Admin and screen-lock password"
    HINT = "For sudo and the lock screen. Once set, it can only be changed at the next start."

    def compose(self) -> ComposeResult:
        with Center(classes="card"):
            with Vertical():
                yield from self.head()
                yield Input(password=True, placeholder="password", id="pw1")
                yield Input(password=True, placeholder="again", id="pw2")
                with Horizontal(classes="buttons"):
                    yield Button("Back", id="back")
                    yield Button("Set", variant="primary", id="go")
                yield Label("", id="msg")
        yield Footer()

    def on_mount(self):
        self.query_one("#pw1").focus()

    @on(Input.Submitted, "#pw1")
    def next_field(self):
        self.query_one("#pw2", Input).focus()

    @on(Button.Pressed, "#back")
    def back(self):
        self.app.pop_screen()

    @on(Input.Submitted, "#pw2")
    @on(Button.Pressed, "#go")
    def go(self):
        a, b = self.query_one("#pw1", Input), self.query_one("#pw2", Input)
        if not a.value or a.value != b.value:
            self.say("Type the same password twice.", error=True); return
        r = daemon("set_password", password=a.value)
        a.value = b.value = ""
        if not r.get("ok"):
            self.say(r.get("error") or "could not set it", error=True); return
        self.app.pop_screen()


class Greeter(App):
    ENABLE_COMMAND_PALETTE = False                      # no Ctrl+P command palette in a greeter
    CSS = """
    /* solid: with a see-through screen the previous screens' cards showed behind the current one */
    Screen { align: center middle; background: $background; }
    /* foot fills the pixels left over below the last text row with its see-through background; a solid footer
       would end above them and leave a strip of wallpaper under it, so the footer is see-through too */
    Footer { background: transparent; }
    .card { width: 78; max-width: 95%; height: auto; max-height: 96%; padding: 1 3;
            background: $surface 85%; border: round $primary 60%; }
    /* every screen scrolls as a whole when it doesn't fit (small screens, big fonts), on top of the scrolling
       middle; focus moving with Tab scrolls the focused field into view */
    .card > Vertical { height: auto; max-height: 100%; overflow-y: auto; scrollbar-size-vertical: 1; }
    /* the middle of a screen scrolls (focus follows into view); title, buttons and messages always stay visible */
    .body { height: auto; max-height: 55vh; scrollbar-size-vertical: 1; }
    #brand { color: $primary; text-style: bold; }
    .title { text-style: bold; margin: 1 0 0 0; }
    .sub { text-style: bold; margin: 1 0 0 0; }
    .hint { color: $text-muted; margin: 0 0 1 0; }
    .warn { color: $warning; }
    .row { height: auto; margin: 1 0 0 0; }
    .row Label { padding: 1 1; width: 1fr; }
    /* long text wraps instead of being cut off at the card's edge */
    Label { width: 100%; }
    .row Label, .buttons Label { width: 1fr; }
    .buttons { height: auto; margin: 1 0 0 0; align-horizontal: right; }
    .buttons Button { margin: 0 0 0 1; }
    #nets { height: 12; max-height: 40vh; border: round $primary 30%; }
    #lines { height: 5; }
    #msg { margin: 1 0 0 0; }
    #msg.error, #net.error { color: $error; }
    #net { margin: 1 0 0 0; color: $primary; }
    #pia, #tor, #vpnbox, #acct { height: auto; }
    /* sections inside a scrolling middle grow with their content (a plain Vertical would take a
       share of the space instead, and then nothing scrolls) */
    .body Vertical, .body Horizontal { height: auto; }
    #busy { height: 1; }
    """

    persistence = "none"
    mode = ""
    session = "normal"
    settings = False                                    # True: Lacuna Settings in the session, not the greeter

    def on_mount(self):
        try:
            c = json.load(open(PALETTE))
            col = lambda k, d: "#" + c.get(k, d).lstrip("#")
            self.register_theme(Theme(name="lacuna", primary=col("primary", "#a6c8ff"),
                                      secondary=col("secondary", "#bdc7dc"), accent=col("tertiary", "#dbbce1"),
                                      background=col("surface", "#111318"), surface=col("surfaceContainer", "#1d2024"),
                                      panel=col("surfaceHigh", "#272a2f"), foreground=col("text", "#e2e2e9"),
                                      error=col("error", "#ffb4ab"), dark=True,
                                      variables={"footer-background": "transparent",
                                                 "footer-item-background": "transparent",
                                                 "footer-description-background": "transparent"}))
            self.theme = "lacuna"
        except Exception:
            self.theme = "textual-dark"
        if self.settings:
            self.push_screen(SettingsHome()); return
        for _ in range(20):                             # greeterd may still be starting
            st = daemon("state")
            if st.get("ok"):
                break
            time.sleep(0.25)
        if st.get("stickless"):                         # nothing to unlock: the stick may already be gone
            self.persistence = "stickless"
            self.push_screen(RemoveStick())
        else:
            self.push_screen(Passphrase())


if __name__ == "__main__":
    app = Greeter()
    app.settings = "--settings" in sys.argv[1:]
    app.run()
